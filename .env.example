# ==============================================================================
# Enterprise Agentic Financial Operations Assistant (FinOps AI Employee)
# Environment Configuration Template (Safe for Version Control)
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database & State Store (SQLite WAL for local, PostgreSQL for AWS/Production)
DATABASE_URL=sqlite+aiosqlite:///./data/finops.db

# AI & LLM Services
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Telegram Bot Gateway
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_MODE=polling
TELEGRAM_MANAGER_CHAT_ID=

# ERPNext Integration (System of Record)
# Set to 'mock' for 100% offline zero-friction execution, or 'live' for real Frappe Cloud
ERPNEXT_MODE=mock
ERPNEXT_BASE_URL=https://your-company.frappe.cloud
ERPNEXT_API_KEY=your_frappe_api_key
ERPNEXT_API_SECRET=your_frappe_api_secret

# Financial Governance & Policy Thresholds
MAX_AUTO_REFUND_LIMIT=200.00
MAX_FRAUD_RISK_THRESHOLD=0.30
MAX_DAILY_REFUND_CAP=5000.00
